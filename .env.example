# JLR Miner Tracker v2.2 - website deployment
PORT=3187

# Public HTTPS URL when hosted, no trailing slash.
# Example: https://miner.example.com
# If omitted, JLR infers the URL from the incoming request/proxy headers.
PUBLIC_URL=

# Register a WEB application at https://developers.eveonline.com/
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Exact callback to register in the EVE developer portal:
# https://YOUR-DOMAIN/auth/eve/callback

# Use long random values in production. If omitted, JLR creates a local token key.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

ESI_USER_AGENT=JLR-Miner-Tracker/2.2 contact=your-email-or-discord
ESI_COMPATIBILITY_DATE=2026-09-16

# Optional shared Tracker support service. Deploy services/tracker-support as a
# second Railway service, then point the main JLR service at its private/public URL.
TRACKER_SUPPORT_URL=
TRACKER_SUPPORT_SHARED_SECRET=
# Optional separate HMAC secret for opaque per-user support keys.
# If blank, TRACKER_SUPPORT_SHARED_SECRET is used.
TRACKER_SUPPORT_USER_KEY_SECRET=
TRACKER_SUPPORT_TIMEOUT_MS=900
